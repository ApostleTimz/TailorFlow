# Copy to backend/.env for local development
PORT=4000
DATABASE_URL=postgresql:///tailorflow?host=/var/run/postgresql
# Required in production: a random string of 32+ characters (e.g. `openssl rand -hex 32`). Placeholders are rejected.
JWT_SECRET=
# true for hosted databases that require SSL; certificates are verified by default
DATABASE_SSL=false
# Custom CA path, e.g. certs/aiven-ca.pem for Aiven; keep sslmode out of DATABASE_URL
DATABASE_SSL_CA=
# Set to 1 behind a proxy or platform load balancer so rate limiting sees real IPs
TRUST_PROXY=0
# Off by default in production; local development may leave this true for initial table creation
DB_SYNC=false

# Public HTTPS origin of the app, used in links and to validate cross-site writes
APP_URL=http://localhost:5173
# Set to false to skip email verification outside production
REQUIRE_EMAIL_VERIFICATION=true

# Requests per 15 minutes: 10 for sign-in/signup/reset attempts, 300 for other API routes
AUTH_RATE_LIMIT=10
API_RATE_LIMIT=300
# SMTP is required in production; local development logs links to the backend terminal
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Local directory for measurement design images; use a persistent volume in production
UPLOAD_DIR=
# WhatsApp order notifications (Meta Cloud API). Leave blank locally to print a preview.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with body: Hi {{1}}, your order {{2}} is confirmed. Garments: {{3}}. Balance: {{4}}. Delivery date: {{5}}.
WHATSAPP_TEMPLATE_NAME=order_confirmation
# Approved template for fully paid orders: Hi {{1}}, your order {{2}} is confirmed. Garments: {{3}}. Delivery date: {{4}}.
WHATSAPP_PAID_TEMPLATE_NAME=order_paid_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v21.0
# Used when a customer phone number is stored without a country code
WHATSAPP_DEFAULT_COUNTRY_CODE=234
